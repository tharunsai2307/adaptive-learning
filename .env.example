# ===========================================
# AdaptiveLearn – Environment Configuration
# ===========================================

# Database URL
# For SQLite (default, works out of the box):
DATABASE_URL=sqlite:///./database/adaptivelearn.db
# For PostgreSQL (uncomment and configure):
# DATABASE_URL=postgresql://username:password@localhost:5432/adaptivelearn

# JWT Authentication
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Google Gemini API (AI Tutor + Quiz Generation)
GEMINI_API_KEY=your-gemini-api-key-here

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_URL=http://localhost:5173
